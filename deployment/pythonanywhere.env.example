# Copy to /home/YOUR_USERNAME/PeerTrain/.env and replace all placeholders.
DEBUG=false
SHOW_DEMO_ACCOUNTS=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com
DJANGO_DB_PATH=/home/YOUR_USERNAME/PeerTrain/db.sqlite3
ADMIN_REGISTRATION_CODE=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Copy the provider, model and API key values from your working local setup.
LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_YOUR_API_KEY
OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
BOUNDARY_JUDGE_ENABLED=false

# To use Gemini instead, set LLM_PROVIDER=google and supply these values:
# GEMINI_API_KEY=REPLACE_WITH_YOUR_API_KEY
# GOOGLE_MODEL=gemini-2.5-flash
